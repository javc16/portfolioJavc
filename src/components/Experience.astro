---
const { experience } = Astro.props;
---

<article class="group border-b border-white/15 py-8 transition hover:bg-white/[0.025] sm:py-10">
  <div class="grid gap-6 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <h2 class="font-mono mb-4 text-xs uppercase tracking-[0.16em] text-[#d9ff56]">{experience.years}</h2>
        <p class="font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-white/35">
          <span data-lang="en">{experience.role}</span>
          <span data-lang="es">{experience.roleEs ?? experience.role}</span>
        </p>
      </div>
      <div class="lg:col-span-4">
      <h3 class="text-2xl font-semibold tracking-[-0.035em] text-[#f2efe6] sm:text-3xl">{experience.company}</h3>
    <p class="mt-4 max-w-lg text-base leading-7 text-white/50">
      <span data-lang="en">{experience.description}</span>
      <span data-lang="es">{experience.descriptionEs ?? experience.description}</span>
    </p>
      </div>
    <ul class="grid max-w-3xl gap-3 lg:col-span-5">
      {experience.highlights.map((highlight: string, index: number) => (
        <li class="flex gap-3 text-sm font-medium leading-6 text-white/55">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-[#d9ff56]"></span>
          <span data-lang="en">{highlight}</span>
          <span data-lang="es">{experience.highlightsEs?.[index] ?? highlight}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
