---
import type { project } from "../interfaces/interfaces";
import Card from "./projectCard.astro";
const { projects } = Astro.props;

---

<section id="projects" class="scroll-mt-24 bg-[#f2efe6] px-5 py-24 text-[#11110f] sm:px-8 lg:px-12 lg:py-32">
  <div class="mx-auto max-w-[1400px]">
  <h1 class="max-w-4xl text-5xl font-medium leading-none tracking-[-0.055em] sm:text-7xl">
    <span data-lang="en">My Coding Projects</span>
    <span data-lang="es">Mis Proyectos</span>
  </h1>
  <p class="mb-16 ml-auto mt-6 max-w-xl text-base font-medium leading-7 text-black/55">
    <span data-lang="en">Selected work focused on operational workflows, maintainable APIs, and polished user experiences.</span>
    <span data-lang="es">Trabajo seleccionado enfocado en flujos operativos, APIs mantenibles y experiencias de usuario pulidas.</span>
  </p>
  {
    projects.map((proj: project, index: number) => (
      <>
        <Card>
          <div slot={index % 2 ? "before" : "after"} class="w-full">
            <div class="group border border-black/20 bg-[#11110f] p-2 shadow-soft">
              <div class="font-mono flex items-center justify-between border-b border-white/10 px-2 py-2 text-[9px] uppercase tracking-[0.15em] text-white/40"><span>Project / 0{index + 1}</span><span>Live artifact</span></div>
              <div class="overflow-hidden bg-white">
                <img
                  class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.025]"
                  src={proj.imageUrl}
                  alt={proj.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
          <div class="flex min-h-full w-full flex-col py-2">
            <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <h2 class="text-4xl font-medium leading-none tracking-[-0.045em] sm:text-5xl">{proj.name}</h2>
              {proj.status ? (
                <span class="font-mono w-fit border-b border-black/30 pb-1 text-[10px] uppercase tracking-[0.14em] text-black/45">
                  <span data-lang="en">{proj.status}</span>
                  <span data-lang="es">{proj.statusEs ?? proj.status}</span>
                </span>
              ) : null}
            </div>
            <p class="mb-6 text-base leading-7 text-black/55 sm:text-lg">
              <span data-lang="en">{proj.description}</span>
              <span data-lang="es">{proj.descriptionEs ?? proj.description}</span>
            </p>
            {proj.impact ? (
              <div class="mb-6 border-l-2 border-[#9ab925] pl-4">
                <p class="text-sm font-semibold leading-6 text-black/70">
                  <span data-lang="en">{proj.impact}</span>
                  <span data-lang="es">{proj.impactEs ?? proj.impact}</span>
                </p>
              </div>
            ) : null}
            <ul class="mb-8 flex flex-wrap gap-2">
              {proj.technologies.map((tech: string) => (
                <li class="flex">
                  <div class="font-mono flex items-center rounded-full border border-black/25 px-3 py-1 text-[11px] font-medium text-black/60">
                    <span>{tech}</span>
                  </div>
                </li>
              ))}
            </ul>
            <div class="mt-auto flex flex-col gap-3 text-center sm:flex-row md:text-left">
              {proj.demoUrl !== "" ? (
                <a
                  href={proj.demoUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex justify-center rounded-full bg-[#11110f] px-5 py-2.5 text-sm font-bold text-white no-underline transition hover:bg-[#d9ff56] hover:text-[#11110f]"
                >
                  <span data-lang="en">{proj.primaryAction ?? "View Demo"}</span>
                  <span data-lang="es">{proj.primaryActionEs ?? "Ver Demo"}</span>
                </a>
              ) : null}

              {proj.githubUrl !== "" ? (
                <a
                  href={proj.githubUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex justify-center rounded-full border border-black/30 px-5 py-2.5 text-sm font-bold no-underline transition hover:border-black"
                >
                  <span data-lang="en">Github Repository</span>
                  <span data-lang="es">Repositorio Github</span>
                </a>
              ) : null}
            </div>
          </div>
        </Card>
      </>
    ))
  }
  </div>
</section>
