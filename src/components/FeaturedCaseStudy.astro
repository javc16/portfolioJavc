---
import type { caseStudy } from "../interfaces/interfaces";

const { caseStudy } = Astro.props;

---

<section class="scroll-mt-24 bg-[#11110f] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
  <div class="mx-auto max-w-[1400px]">
    <div class="mb-12 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="font-mono mb-5 text-xs uppercase tracking-[0.2em] text-[#d9ff56]">
          <span data-lang="en">{caseStudy.eyebrow}</span>
          <span data-lang="es">{caseStudy.eyebrowEs}</span>
        </p>
        <h2 class="mb-6 text-5xl font-medium leading-none tracking-[-0.055em] text-[#f2efe6] sm:text-7xl">
          <span data-lang="en">{caseStudy.title}</span>
          <span data-lang="es">{caseStudy.titleEs}</span>
        </h2>
        <p class="max-w-2xl text-base font-medium leading-7 text-white/55 sm:text-lg">
          <span data-lang="en">{caseStudy.summary}</span>
          <span data-lang="es">{caseStudy.summaryEs}</span>
        </p>
        <ul class="mt-7 flex flex-wrap gap-2">
          {caseStudy.technologies.map((tech: string) => (
            <li class="rounded-full border border-white/20 px-3 py-1 text-xs font-bold text-white/65">
              {tech}
            </li>
          ))}
        </ul>
        <a
          href={caseStudy.url}
          target="_blank"
          rel="noreferrer"
          class="mt-8 inline-flex items-center gap-3 rounded-full bg-[#d9ff56] px-6 py-3 text-sm font-bold text-[#11110f] transition hover:bg-white"
        >
          <span data-lang="en">Visit public site</span>
          <span data-lang="es">Ver sitio publico</span>
        </a>
      </div>

      <div class="lg:col-span-4 lg:col-start-9">
        <div class="overflow-hidden border border-white/15 bg-black p-2 shadow-soft">
          <img src={caseStudy.imageUrl} alt={caseStudy.title} class="aspect-[16/11] w-full object-cover object-top" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>

    <div class="grid border-t border-white/15 lg:grid-cols-3">
        <article class="border-b border-white/15 py-8 lg:border-b-0 lg:border-r lg:pr-8">
          <h3 class="font-mono mb-4 text-xs uppercase tracking-[0.2em] text-white/35">
            <span data-lang="en">Problem</span>
            <span data-lang="es">Problema</span>
          </h3>
          <p class="text-sm font-medium leading-6 text-white/65">
            <span data-lang="en">{caseStudy.problem}</span>
            <span data-lang="es">{caseStudy.problemEs}</span>
          </p>
        </article>
        <article class="border-b border-white/15 py-8 lg:border-b-0 lg:border-r lg:px-8">
          <h3 class="font-mono mb-4 text-xs uppercase tracking-[0.2em] text-white/35">
            <span data-lang="en">My role</span>
            <span data-lang="es">Mi rol</span>
          </h3>
          <p class="text-sm font-medium leading-6 text-white/65">
            <span data-lang="en">{caseStudy.role}</span>
            <span data-lang="es">{caseStudy.roleEs}</span>
          </p>
        </article>
        <article class="py-8 lg:pl-8">
          <h3 class="font-mono mb-4 text-xs uppercase tracking-[0.2em] text-[#d9ff56]">
            <span data-lang="en">Solution</span>
            <span data-lang="es">Solucion</span>
          </h3>
          <p class="text-sm font-medium leading-6 text-white/80">
            <span data-lang="en">{caseStudy.solution}</span>
            <span data-lang="es">{caseStudy.solutionEs}</span>
          </p>
        </article>
    </div>

    <div class="mt-16 grid gap-12 border-t border-white/15 pt-10 lg:grid-cols-2">
      <div>
        <h3 class="mb-6 text-2xl font-semibold tracking-tight text-white">
          <span data-lang="en">Architecture</span>
          <span data-lang="es">Arquitectura</span>
        </h3>
        <ul class="grid border-t border-white/10">
          {caseStudy.architecture.map((item: string, index: number) => (
            <li class="border-b border-white/10 py-4 text-sm font-medium leading-6 text-white/55">
              <span data-lang="en">{item}</span>
              <span data-lang="es">{caseStudy.architectureEs[index]}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="mb-6 text-2xl font-semibold tracking-tight text-white">
          <span data-lang="en">Qualitative outcomes</span>
          <span data-lang="es">Beneficios cualitativos</span>
        </h3>
        <ul class="grid border-t border-white/10">
          {caseStudy.outcomes.map((item: string, index: number) => (
            <li class="border-b border-white/10 py-4 text-sm font-medium leading-6 text-white/55">
              <span data-lang="en">{item}</span>
              <span data-lang="es">{caseStudy.outcomesEs[index]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
