---
// src/components/ImageText.astro
const { profile, technologies } = Astro.props;

---

<section class="relative bg-[#d9ff56] px-5 py-24 text-[#11110f] sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto grid max-w-[1400px] items-end gap-12 lg:grid-cols-12">
  <div class="lg:col-span-7 lg:col-start-2">
    <p class="mb-8 text-5xl font-medium leading-none tracking-[-0.055em] sm:text-7xl">
      <span data-lang="en">{profile.presentationText}</span>
      <span data-lang="es">{profile.presentationTextEs}</span>
    </p>
    <p class="max-w-2xl text-lg font-medium leading-8 text-black/60 sm:text-xl">
      <span data-lang="en">{profile.experienceText}</span>
      <span data-lang="es">{profile.experienceTextEs}</span>
    </p>
    <p class="font-mono mb-5 mt-12 text-xs font-medium uppercase tracking-[0.2em] text-black/45">
      <span data-lang="en">{profile.stackText}</span>
      <span data-lang="es">{profile.stackTextEs}</span>
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        technologies.map((tech: string) => (
          <li class="flex">
            <div class="rounded-full border border-black/30 px-4 py-2 text-sm font-bold transition hover:bg-[#11110f] hover:text-[#d9ff56]">
              <span>{tech}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <figure class="relative lg:col-span-3 lg:col-start-10">
    <div class="absolute -left-5 -top-5 h-full w-full border border-black/30"></div>
    <img class="relative aspect-[3/4] w-full object-cover object-[center_30%] grayscale" src={profile.imageUrl} alt="Alexander Villalvir profile" loading="lazy" decoding="async" />
    <figcaption class="font-mono mt-4 flex justify-between text-[10px] uppercase tracking-[0.15em] text-black/50"><span>Profile / 2026</span><span>HN</span></figcaption>
  </figure>
  </div>
</section>
