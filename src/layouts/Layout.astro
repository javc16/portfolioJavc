---
import ViewTransitions from "astro/components/ViewTransitions.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const description =
  "Alexander Villalvir, full-stack developer specializing in Angular, .NET, SQL, APIs, and business-critical web applications.";
---

<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11110f" />
    <script is:inline>
      const savedLanguage = localStorage.getItem("portfolio-language") || "en";
      document.documentElement.dataset.language = savedLanguage;
      document.documentElement.lang = savedLanguage;
    </script>
    <link rel="preconnect" href="https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com" />
    <link rel="preconnect" href="https://upload.wikimedia.org" />
    <link rel="preconnect" href="https://cdn.prod.website-files.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <meta name="title" property="og:title" content={title} />
    <meta name="description" property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.svg" />

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="bg-[#11110f] antialiased">
    <slot />
    <Footer />
    <script is:inline>
      const setPortfolioLanguage = (language) => {
        document.documentElement.dataset.language = language;
        document.documentElement.lang = language;
        localStorage.setItem("portfolio-language", language);
        document.querySelectorAll("[data-language-button]").forEach((button) => {
          const isActive = button.dataset.languageButton === language;
          button.setAttribute("aria-pressed", String(isActive));
          button.dataset.active = String(isActive);
        });
      };

      document.querySelectorAll("[data-language-button]").forEach((button) => {
        button.addEventListener("click", () => setPortfolioLanguage(button.dataset.languageButton));
      });

      setPortfolioLanguage(document.documentElement.dataset.language || "en");
    </script>
  </body>
  <style is:global>
    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Manrope, ui-sans-serif, system-ui, sans-serif;
      background: #11110f;
    }

    ::selection {
      background: rgb(217 255 86 / 0.3);
    }

    html[data-language="en"] [data-lang="es"],
    html[data-language="es"] [data-lang="en"] {
      display: none;
    }

    [data-language-button][data-active="true"] {
      background: #d9ff56;
      color: #11110f;
    }

    :focus-visible {
      outline: 3px solid rgb(217 255 86 / 0.7);
      outline-offset: 3px;
    }

    .font-mono {
      font-family: "DM Mono", ui-monospace, monospace;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    }
  </style>
</html>
