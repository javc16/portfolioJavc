---
import Layout from "../layouts/Layout.astro";
import CompanyLogos from "../components/CompanyLogos.astro";
import ContactSection from "../components/ContactSection.astro";
import Experiences from "../components/Experiences.astro";
import FeaturedCaseStudy from "../components/FeaturedCaseStudy.astro";
import HeaderInformation from "../components/HeaderInformation.astro";
import MainStack from "../components/MainStack.astro";
import Navbar from "../components/Navbar.astro";
import ProfessionalFocus from "../components/ProfessionalFocus.astro";
import Projects from "../components/Projects.astro";
import VerticalLine from "../components/VerticalLine.astro";
import {
  companyLogos,
  stackArea,
  technologyList,
  projects,
  experienceList,
  featuredCaseStudy,
} from "../data/CvData";
---

<Layout title="Alexander Villalvir">
  <main id="main-content" class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <Navbar />
    <HeaderInformation />
    <CompanyLogos logos={companyLogos} />
    <ProfessionalFocus />
    <MainStack profile={stackArea} technologies={technologyList} />
    <VerticalLine />
    <FeaturedCaseStudy caseStudy={featuredCaseStudy} />
    <VerticalLine />
    <Projects projects={projects} />
    <Experiences experiences={experienceList} />
    <VerticalLine />
    <ContactSection />
  </main>
</Layout>
